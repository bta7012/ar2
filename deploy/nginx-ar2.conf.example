# Block for /ar2 inside the existing server { } of test8.aestar.com.ua.
# WebXR (camera AR) works ONLY over HTTPS.

location = /ar2 { return 301 /ar2/; }

location ^~ /ar2/ {
    alias /var/www/ar2/;
    index index.html;

    types {
        text/html               html;
        text/plain              txt;
        application/javascript  js;
        model/gltf-binary       glb;
    }

    # CI uploads pre-compressed *.gz twins -> served without CPU cost
    gzip_static on;
    gzip on;
    gzip_types application/javascript model/gltf-binary text/plain;

    # hashed bundle (app-XXXXXXXX.js) never changes -> cache for a year; everything else revalidates
    set $ar2_cache "no-cache";
    if ($uri ~ "/app-[A-Z0-9]+\.js$") { set $ar2_cache "public, max-age=31536000, immutable"; }
    add_header Cache-Control $ar2_cache;
    add_header Permissions-Policy "xr-spatial-tracking=(self), camera=(self)";
}
